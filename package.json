{
  "name": "@taskclan/kin-autopilot",
  "version": "0.1.0",
  "description": "Thin TypeScript client for Kin Autopilot (TalentKit extension queue / fill-data / report).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
